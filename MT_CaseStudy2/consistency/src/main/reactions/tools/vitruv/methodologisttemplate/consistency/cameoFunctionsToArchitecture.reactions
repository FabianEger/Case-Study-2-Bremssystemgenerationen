import java.io.File;

import "http://vitruv.tools/cameo_functions" as functions
import "http://vitruv.tools/cameo_architecture" as architecture


reactions: functionsToArchitecture
in reaction to changes in functions
execute actions in architecture

reaction FunctionRenamed {
	after attribute replaced at functions::Function[name]
	call propagateFunctionName(affectedEObject)
}

routine propagateFunctionName(functions::Function function) {
	match {
		val block = retrieve architecture::Block corresponding to function
	}
	update {
		block.name = function.name
	}
}