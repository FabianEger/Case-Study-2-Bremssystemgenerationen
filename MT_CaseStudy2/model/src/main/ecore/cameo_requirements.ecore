<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="cameo_requirements" nsURI="http://vitruv.tools/cameo_requirements"
    nsPrefix="cameo_requirements">
  <eClassifiers xsi:type="ecore:EClass" name="Requirement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="text" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="Id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="references" upperBound="-1"
        eType="#//Requirement">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Case Study 2: a concrete validation-environment requirement references the validation needs (derived by CPR 1 / CPR 2) it covers."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="generations" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Case Study 2 (Cameo tag 'generation' of the RequirementTaggingProfile): product generations the requirement applies to, e.g. Gn-1, Gn, Gn+1."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" eType="#//ValidationStatus">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Case Study 2 (Cameo tag 'Status'): Real or Imaginary."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="classification" eType="#//RequirementClassification">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Case Study 2 (Cameo tag 'Classification'), extended by the two classes created by the product-to-VE CPRs."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="categories" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="reviewRequired" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Case Study 2: set by the CPRs when a corresponding product element was changed or removed ('Änderungsbedarf identifiziert')."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="restVehicleSimulationAffected"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Case Study 2: the requirement implies an extension of the remaining-vehicle simulation (only recorded, the simulation itself is out of scope)."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RequirementsRepository">
    <eStructuralFeatures xsi:type="ecore:EReference" name="requirements" upperBound="-1"
        eType="#//Requirement" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="ValidationStatus">
    <eLiterals name="REAL"/>
    <eLiterals name="IMAGINARY" value="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="RequirementClassification">
    <eLiterals name="UNCLASSIFIED"/>
    <eLiterals name="DERIVED_FROM_TEST_BENCH_ITSELF" value="1"/>
    <eLiterals name="DERIVED_FROM_PRODUCT_TEST_CASE" value="2"/>
    <eLiterals name="VALIDATION_NEED_FROM_PRODUCT_FUNCTION" value="3"/>
    <eLiterals name="VALIDATION_NEED_FROM_PRODUCT_ARCHITECTURE" value="4"/>
  </eClassifiers>
</ecore:EPackage>
