    <nestedPackages xsi:type="sysml:Package" name="00_Requirements_validation_environment" xmi:id="_2022x_2_8dc0261_1749728151411_794644_20110" id="_2022x_2_8dc0261_1749728151411_794644_20110">
      <nestedPackages xsi:type="sysml:Package" name="RequirementTaggingProfile" xmi:id="_2022x_2_8dc0261_1752161697345_418944_20849" id="_2022x_2_8dc0261_1752161697345_418944_20849" />
      <ownedElements xsi:type="sysml:Block" name="Filter Legend" xmi:id="_2022x_2_4490178_1760096232801_96144_23610" id="_2022x_2_4490178_1760096232801_96144_23610" />
      <ownedElements xsi:type="sysml:Requirement" name="Brake Actuation and operating Capability " xmi:id="_2022x_2_6860229_1769633257270_528590_21573" id="1" text="“The test bench shall generate controllable rotational motion and apply braking forces to the brake system under test.”" />
      <ownedElements xsi:type="sysml:Requirement" name="BrakingWithVariousBrakeForce" xmi:id="_2022x_2_8dc0261_1749730069014_607107_20258" id="1.1" text="The braking system test bench shall support braking force or equivalent braking torque levels in a controlled and repeatable manner, enabling evaluation of braking behavior under different braking intensities across all operating modes." />
      <ownedElements xsi:type="sysml:Requirement" name="EmergencyBrakeFrom50" xmi:id="_2022x_2_8dc0261_1749730172205_314449_20289" id="1.2" text="The system shall allow emergency braking operations decelerating a rotating brake component from 50 km/h to 0 km/h using the maximum available brake force&#10;" />
      <ownedElements xsi:type="sysml:Requirement" name="RepeatedBrakingWithoutStopingTheRotationOfTheBrakeDisc" xmi:id="_2022x_2_8dc0261_1749729042169_489225_20144" id="1.3" text="The system shall support repeated braking cycles with variable brake force without the rotating brake component coming to a complete stop." />
      <ownedElements xsi:type="sysml:Requirement" name="BrakingOperationsWithForwardAndReverseRotation" xmi:id="_2022x_2_8dc0261_1749730810055_999452_20320" id="1.4" text="The system shall allow braking operations with both forward and reverse rotation, including the reversal of the rotational direction of the brake component." />
      <ownedElements xsi:type="sysml:Requirement" name="Integrated Parking Brake Functionality" xmi:id="_2022x_2_4490178_1758815412577_418900_20718" id="1.5" text="Parking brake mechanism can be easily integrated into the drum brake assembly without requiring additional systems" />
      <ownedElements xsi:type="sysml:Requirement" name="High Braking Force at Low Pressure" xmi:id="_2022x_2_4490178_1758815377259_440759_20687" id="1.6" text="Drum brakes can generate high braking force with relatively low hydraulic pressure due to the self-energizing effect." />
      <ownedElements xsi:type="sysml:Requirement" name="Simulation of Brake system Operating Conditions " xmi:id="_2022x_2_6860229_1769635690113_47846_21465" id="4" text="“The test bench shall simulate vehicle driving conditions and external influences acting on the brake system.”" />
      <ownedElements xsi:type="sysml:Requirement" name="Road Load Simulation" xmi:id="_2022x_2_4490178_1758815889172_798951_20819" id="4.1" text="The second electric machine shall simulate realistic road load conditions including rolling resistance, aerodynamic drag, and gradient forces" />
      <ownedElements xsi:type="sysml:Requirement" name="Variable Friction Force Simulation" xmi:id="_2022x_2_4490178_1758815915396_390409_20850" id="4.2" text="The machine shall generate resistive torque to replicate tire–road friction under different surface conditions (dry, wet, icy)." />
      <ownedElements xsi:type="sysml:Requirement" name="Wheel Slip Emulation" xmi:id="_2022x_2_4490178_1758815945125_612062_20881" id="4.3" text="The system shall emulate wheel slip dynamics to reproduce traction loss scenarios for vehicle stability analysis." />
      <ownedElements xsi:type="sysml:Requirement" name="Slip Ratio Simulation" xmi:id="_2022x_2_4490178_1758828893959_54729_20612" id="4.4" text="The system shall emulate wheel slip conditions under different road surfaces such as dry, wet, and icy roads" />
      <ownedElements xsi:type="sysml:Requirement" name="Bidirectional Torque Capability" xmi:id="_2022x_2_4490178_1758815969363_280131_20912" id="4.5" text="The second electric machine shall apply both positive and negative torque to simulate uphill, downhill, and braking conditions." />
      <ownedElements xsi:type="sysml:Requirement" name="Safety and Overload Protection" xmi:id="_2022x_2_4490178_1758816094598_963822_20943" id="4.6" text="The second electric machine shall include protection mechanisms to prevent damage under overload, excessive slip, or unexpected torque spikes during test scenarios." />
      <ownedElements xsi:type="sysml:Requirement" name="Emergency Braking Scenarios" xmi:id="_2022x_2_4490178_1758828897494_228989_20674" id="4.7" text="The system shall simulate emergency braking maneuvers at varying speeds to assess ABS effectiveness in reducing stopping distance" />
      <ownedElements xsi:type="sysml:Requirement" name="Coordinated Brake Force Distribution" xmi:id="_2022x_2_4490178_1758829382660_668459_20780" id="4.9" text="The system shall coordinate hydraulic ABS braking with recuperative braking to maintain vehicle stability and maximize energy recovery" />
      <ownedElements xsi:type="sysml:Requirement" name="Brake Torque Modulation" xmi:id="_2022x_2_4490178_1758828895579_346681_20643" id="4.8" text="The test bench shall allow rapid modulation of brake torque to validate ABS response during lock-up prevention" />
      <ownedElements xsi:type="sysml:Requirement" name="Modular Brake system Integeration " xmi:id="_2022x_2_6860229_1769635869020_987590_21496" id="5" text="The test bench shall allow easy installation, adjustment, and exchange of brake systems under test" />
      <ownedElements xsi:type="sysml:Requirement" name="EasyExchangeBrakeSystem" xmi:id="_2022x_2_8dc0261_1749730959386_377878_20351" id="5.1" text="The mechanical interface shall allow simple exchange of the brake system under test using standard tools, without major structural modifications." />
      <ownedElements xsi:type="sysml:Requirement" name="EasyExchangeBrakeCaliper" xmi:id="_2022x_2_8dc0261_1752159608877_639137_20685" id="5.2" text="The brake caliper must be mounted laterally to the brake disc to enable compatibility with different brake system geometries." />
      <ownedElements xsi:type="sysml:Requirement" name="AdjustablePositionBrakeCaliper" xmi:id="_2022x_2_8dc0261_1752159419486_127735_20654" id="5.3" text="The brake caliper holder must allow quick repositioning of the brake caliper in all three spatial directions using elongated holes or equivalent adjustment features." />
      <ownedElements xsi:type="sysml:Requirement" name="ShortLeverArmBrakeCaliperHolder" xmi:id="_2022x_2_8dc0261_1752159684303_654782_20716" id="5.4" text="The brake caliper holder shall minimize the lever arm relative to the braking force to reduce structural loads." />
      <ownedElements xsi:type="sysml:Requirement" name="Compatibility with Smaller Wheel Sizes" xmi:id="_2022x_2_4490178_1758815416174_79604_20780" id="5.5" text="Drum brakes can be packaged more easily within smaller wheel sizes compared to disc brakes, supporting compact vehicle designs." />
      <ownedElements xsi:type="sysml:Requirement" name="FrictionChangeByPadReplacement" xmi:id="_2022x_2_8dc0261_1749731080841_924146_20382" id="5.6" text="It shall be possible to change the friction conditions by replacing the friction material without requiring major changes to the test environment." />
      <ownedElements xsi:type="sysml:Requirement" name="Mechanical Integrity and structural safety " xmi:id="_2022x_2_6860229_1769637126574_520425_21539" id="2" text="“The test bench shall remain structurally safe, mechanically stable, and manufacturable under all operating conditions.”" />
      <ownedElements xsi:type="sysml:Requirement" name="NoFailureUnderMaxLoad" xmi:id="_2022x_2_8dc0261_1749731526769_259229_20506" id="2.1" text="All load-bearing components shall be designed to withstand the maximum expected operational loads without failure or critical crack formation." />
      <ownedElements xsi:type="sysml:Requirement" name="NoFailureUnderMaxSpeed" xmi:id="_2022x_2_8dc0261_1752158700554_43138_20421" id="2.2" text="All rotating components shall be designed to withstand the maximum operating speed without structural failure, excessive vibration, or critical resonance." />
      <ownedElements xsi:type="sysml:Requirement" name="NoCriticalEigenfrequencies" xmi:id="_2022x_2_8dc0261_1749731577142_946046_20537" id="2.3" text="The system shall prevent resonance effects from vibrations induced by braking forces or other actuators such as electric machines." />
      <ownedElements xsi:type="sysml:Requirement" name="Bearing Arrangement for External Load Support" xmi:id="_2022x_2_4490178_1758368956833_584187_25888" id="2.4" text="The bearing arrangement should have maximize tilting rigidity and effectively absorb external forces and torques applied outside the bearing span (from the electric machine and braking system)." />
      <ownedElements xsi:type="sysml:Requirement" name="BearingSufficientlyDimensioned" xmi:id="_2022x_2_8dc0261_1752158475934_5908_20390" id="2.5" text="The bearing concept shall support the radial and axial forces applied without introducing mechanical overconstraints or preload under normal operating conditions." />
      <ownedElements xsi:type="sysml:Requirement" name="ManufacturableByConventionalMethods" xmi:id="_2022x_2_8dc0261_1749731445151_202187_20475" id="2.6" text="All physical components of the system shall be manufacturable using conventional techniques such as turning, milling, laser cutting, and welding." />
      <ownedElements xsi:type="sysml:Requirement" name="Thermal Expansion Accommodation" xmi:id="_2022x_2_4490178_1757960492031_76055_20548" id="2.7" text="It tends to increase preload as the shaft expands (due to heat), which can be beneficial in high-temperature environments where stability is required." />
      <ownedElements xsi:type="sysml:Requirement" name="Alignment Stability" xmi:id="_2022x_2_4490178_1757960599183_282540_20583" id="2.8" text="More tolerant of misalignment between shaft and housing." />
      <ownedElements xsi:type="sysml:Requirement" name="High Moment Rigidity" xmi:id="_2022x_2_4490178_1757960269464_560696_20484" id="2.9" text="The spread of the contact lines (large effective span between load centers) gives the system greater resistance to tilting and bending moments." />
      <ownedElements xsi:type="sysml:Requirement" name="Friction Adaptation Capability" xmi:id="_2022x_2_6860229_1769637733190_755861_21603" id="3" text="“The test bench shall allow modification of friction conditions during testing.”" />
      <ownedElements xsi:type="sysml:Requirement" name="FrictionChangeByFluidApplication" xmi:id="_2022x_2_8dc0261_1749731220126_556561_20413" id="3.2" text="It shall be possible to change the friction conditions by applying defined fluids (e.g., oil, water) without requiring extensive modifications to the setup." />
      <ownedElements xsi:type="sysml:Requirement" name="Low- and High-friction  Surface Testing" xmi:id="_2022x_2_4490178_1758829027380_446523_20705" id="3.1" text="The system shall replicate braking on low-friction (ice, wet) and high-friction (dry asphalt) surfaces to evaluate ABS adaptability" />
      <ownedElements xsi:type="sysml:Requirement" name="Measurement, Data Recording and Control" xmi:id="_2022x_2_6860229_1769639382052_865215_21758" id="6" text="“The test bench shall measure, record, and allow control interventions during braking tests.”" />
      <ownedElements xsi:type="sysml:Requirement" name="Wheel Speed Measurement" xmi:id="_2022x_2_4490178_1758828892239_308749_20581" id="6.1" text="The system shall provide accurate wheel speed measurement signals to detect incipient wheel lock during braking" />
      <ownedElements xsi:type="sysml:Requirement" name="SensorProximityAndProtection" xmi:id="_2022x_2_8dc0261_1749731604103_685329_20568" id="6.2" text="Sensors (e.g., force, temperature, rotational speed) shall be placed close to the system under test while being protected against brake dust, heat, and fluids." />
      <ownedElements xsi:type="sysml:Requirement" name="Recording and evaluating Data for braking" xmi:id="_2022x_2_4490178_1758829521977_480249_20904" id="6.3" text="The system shall record recovered energy, braking torque distribution, wheel slip, and stopping distance to evaluate ABS and recuperative braking performance" />
      <ownedElements xsi:type="sysml:Requirement" name="ECUInterventionCapability" xmi:id="_2022x_2_8dc0261_1749731274560_428938_20444" id="6.4" text="The test environment shall allow interventions on the brake ECU, including the use of alternative control units or signal overlay for testing intervention strategies." />
      <ownedElements xsi:type="sysml:Requirement" name="Data Logging for ABS Performance" xmi:id="_2022x_2_4490178_1758829032052_215115_20736" id="6.5" text="The system shall record braking distance, stopping time, and slip ratio data to analyze ABS system performance across test conditions" />
    </nestedPackages>
  </nestedPackages>
